# ---------------------------------------------------------------------------
# wandermaeuse.de
#
# Diese Datei ist die Vorlage. Auf dem netcup-Webspace liegt eine echte .env,
# die NICHT im Git-Repository ist - sie wird einmalig per SSH angelegt.
# Siehe DEPLOYMENT.md.
# ---------------------------------------------------------------------------

APP_NAME="Wandermäuse"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wandermaeuse.de

APP_LOCALE=de
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# netcup: Datenbank im WCP anlegen, Zugangsdaten hier eintragen.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Dateibasiert: Shared Hosting hat kein Redis, und so bleibt die Datenbank
# für die Inhalte frei.
SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file

# Es läuft kein Queue-Daemon; der Cronjob leert die Queue jede Minute.
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

# netcup-Postfach für Bestätigungs- und Newsletter-Mails.
# MAIL_HOST muss der netcup-Mailserver sein – der MX der Domain, nicht der
# Hostname aus einer fremden Anleitung. Ein Postfach bei netcup lässt sich
# nirgendwo sonst authentifizieren und liefert sonst nur "535".
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.wandermaeuse.de
MAIL_PORT=465
MAIL_USERNAME=newsletter@wandermaeuse.de
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="newsletter@wandermaeuse.de"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
